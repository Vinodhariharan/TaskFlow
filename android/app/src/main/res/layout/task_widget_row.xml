<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the Tasks widget's scrolling list. Only RemoteViews-capable
     view types (see task_widget.xml); the tick is an ImageView rather than a
     bare View for exactly that reason. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <ImageView
        android:id="@+id/task_row_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_check_circle"
        android:contentDescription="@string/complete_task_action" />

    <TextView
        android:id="@+id/task_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:textColor="@color/widget_secondary_text"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
