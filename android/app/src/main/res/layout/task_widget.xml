<?xml version="1.0" encoding="utf-8"?>
<!-- Every view type here must be one RemoteViews accepts (i.e. annotated
     @RemoteView in the framework): layouts, TextView, ImageView, ListView and
     friends. A bare <View> is NOT on that list — using one for the tick
     targets once made the launcher fail to inflate the whole widget.

     The task rows are a ListView rather than a fixed set of TextViews so the
     widget scrolls through everything due today instead of showing the first
     three. Its rows come from TaskWidgetService. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/task_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/task_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tasks"
                android:textColor="@color/widget_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/task_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Open Upkeep"
                android:textColor="@color/widget_primary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/task_add"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:contentDescription="@string/add_task_action" />
    </LinearLayout>

    <ListView
        android:id="@+id/task_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <!-- Shown by the provider in place of the list when there's nothing due.
         An empty view has to be a sibling of the collection it replaces. -->
    <TextView
        android:id="@+id/task_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:text="@string/task_widget_empty"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />
</LinearLayout>
