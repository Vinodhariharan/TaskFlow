<?xml version="1.0" encoding="utf-8"?>
<!-- Only RemoteViews-capable view types here (see task_widget.xml for what
     happens otherwise).

     Everything is sized to fit inside a single home screen cell: two short
     text lines and the dot strip come to roughly 55dp including padding,
     which every launcher gives a one-cell widget. An earlier version showed
     the strip only above a measured height threshold, which was the wrong
     idea twice over — OPTION_APPWIDGET_MIN_HEIGHT reports the launcher's
     lower bound for the current span rather than the height the widget is
     actually drawn at, so the strip stayed hidden at one cell even with
     room to spare. Fitting the content to the cell needs no measuring. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habit_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/habit_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/habit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/habit_widget_placeholder"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/habit_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_primary"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/habit_action"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:contentDescription="@string/log_habit_action" />
    </LinearLayout>

    <!-- Last seven days, oldest on the left, today on the right. -->
    <LinearLayout
        android:id="@+id/habit_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/habit_day_0"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/widget_dot_open"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/habit_day_1"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/widget_dot_open"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/habit_day_2"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/widget_dot_open"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/habit_day_3"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/widget_dot_open"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/habit_day_4"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/widget_dot_open"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/habit_day_5"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/widget_dot_open"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/habit_day_6"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/widget_dot_open"
            android:contentDescription="@null" />
    </LinearLayout>

</LinearLayout>
