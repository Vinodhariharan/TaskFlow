<?xml version="1.0" encoding="utf-8"?>
<!-- Shown when a habit widget is placed, and again from the launcher's
     "reconfigure" menu. An ordinary Activity, not RemoteViews, so there's no
     restriction on the views used here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/habit_widget_configure_title"
        android:textColor="@color/widget_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/habit_choice_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/habit_widget_configure_empty"
        android:textColor="@color/widget_secondary_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/habit_choice_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:divider="@null"
        android:dividerHeight="0dp" />
</LinearLayout>
