<?xml version="1.0" encoding="utf-8"?>
<!-- The open ring: a progress arc that never quite closes.

     Drawn as a single stroked arc rather than a filled shape, so one path
     serves the launcher, the themed (monochrome) variant and the status bar
     at three different sizes with nothing to keep in sync.

     The 108dp adaptive canvas is masked to roughly its middle 72dp, so the
     mark is sized to sit inside that: radius 20 plus half of an 11dp stroke
     is 25.5, comfortably clear of the 36dp the mask allows. Anything wider
     would be shaved off by a circular mask. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M66.856,38.679 A20,20 0 1 1 41.144,38.679"
        android:fillColor="#00000000"
        android:strokeColor="#6C63FF"
        android:strokeWidth="11"
        android:strokeLineCap="round" />
</vector>
