<?xml version="1.0" encoding="utf-8"?>
<!-- The tick target on each task row: an empty ring, matching the unchecked
     circle the in-app task tiles draw. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="2dp" android:color="@color/widget_muted" />
    <size android:width="20dp" android:height="20dp" />
</shape>
