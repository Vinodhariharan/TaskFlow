<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- For scheduled task-reminder notifications (flutter_local_notifications). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- SCHEDULE_EXACT_ALARM is denied by default on Android 14+ for apps that
         aren't alarm/calendar apps, which silently downgraded every reminder to
         an inexact alarm — those get deferred by Doze, often long past the time
         the user picked, which reads as "reminders don't work". USE_EXACT_ALARM
         is auto-granted with no prompt (requires targetSdk >= 33) and is the
         permission intended for user-set alarm/reminder times. Both are kept:
         USE_EXACT_ALARM covers Android 13+, SCHEDULE_EXACT_ALARM covers 12. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application
        android:label="taskflow"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- flutter_local_notifications: these receivers are what actually turn a
             scheduled alarm into a shown notification, and re-arm alarms after a
             reboot. The plugin ships the *classes* but doesn't declare them in its
             own manifest in this version, so without this block every zonedSchedule
             call silently no-ops at the OS level — it "succeeds" with no exception,
             but nothing ever fires. -->
        <!-- Home screen widgets. Every one of them is rendered from strings
             that Dart writes via home_widget, so they carry no logic of their
             own. -->
        <receiver
            android:name=".TaskWidgetProvider"
            android:exported="true"
            android:label="TaskFlow Tasks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/task_widget_info" />
        </receiver>
        <receiver
            android:name=".ExpenseWidgetProvider"
            android:exported="true"
            android:label="TaskFlow Expenses">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/expense_widget_info" />
        </receiver>
        <!-- Backs the Tasks widget's scrolling list. Not exported, but the
             system needs BIND_REMOTEVIEWS to be allowed to bind to it. -->
        <service
            android:name=".TaskWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Asks which habit a placed habit widget should track. Runs at
             placement, and again from the launcher's reconfigure menu. -->
        <activity
            android:name=".HabitWidgetConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/HabitWidgetConfigureTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".HabitWidgetProvider"
            android:exported="true"
            android:label="TaskFlow Habit">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habit_widget_info" />
        </receiver>
        <receiver
            android:name=".QuickAddWidgetProvider"
            android:exported="true"
            android:label="TaskFlow Quick Add">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_widget_info" />
        </receiver>

        <!-- Receives the "tick this task off" broadcast from the Tasks widget
             and hands it to a background Dart isolate. home_widget ships this
             class but declares nothing in its own manifest, so without this
             entry the tick buttons would do nothing at all. -->
        <receiver
            android:name="es.antonborri.home_widget.HomeWidgetBackgroundReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.BACKGROUND" />
            </intent-filter>
        </receiver>

        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
